# ============================================================================
# CUSTOM EXCLUSIONS FOR THIS PROJECT
# ============================================================================

# Exclude ALL model weights (they're large binary files)
models/weights/
*.pth
*.pt
*.pkl
*.joblib

# Exclude ALL data folder contents (audio files are large)
data/
!data/raw/clean_real/  # Keep directory structure
data/raw/clean_real/*.wav  # But exclude actual audio files
!data/raw/clean_ai/    # Keep directory structure  
data/raw/clean_ai/*.wav  # But exclude actual audio files
!data/augmented_balanced/human/  # Keep directory structure
data/augmented_balanced/human/*.wav  # But exclude actual audio files
!data/augmented_balanced/ai/  # Keep directory structure
data/augmented_balanced/ai/*.wav  # But exclude actual audio files
!data/raw/noise_samples/  # Keep directory structure
data/raw/noise_samples/*  # But exclude all noise samples

# Exclude test demo folder contents (sample audio files)
!test_demo/  # Keep the directory
test_demo/*.wav  # But exclude WAV files
test_demo/*.mp3  # But exclude MP3 files

# Exclude results folder (generated files)
results/
!results/  # Keep directory
results/*  # But exclude all contents

# Exclude any large generated files
*.csv
hybrid_detection_results.csv

# Legacy exclusions from previous projects
noise_robust_detector/
data_enhanced/
data_normalized/
ai_003.wav

# Exclude cache and temp files
.cache/
temp/
tmp/
*.tmp
*.temp

# Keep only these important files in the project root:
# - config/ (configuration files)
# - models/ (Python model definitions, NOT weights)
# - scripts/ (Python scripts)
# - utils.py (utility functions)
# - requirements.txt (dependencies)
# - README.md (documentation)
# - .gitignore (this file)
# - project_config.py (project configuration)


